[configuration]
entry_symbol = "wowgd_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]
linux.debug.x86_64 = "res://bin/libwowgd.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libwowgd.linux.template_release.x86_64.so"
windows.debug.x86_64 = "res://bin/libwowgd.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libwowgd.windows.template_release.x86_64.dll"
