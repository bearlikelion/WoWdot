[node name="HelpFrameGMTalkTitle" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 25
offset_top = 65
offset_right = 575
offset_bottom = 81
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontNormalLarge"
text = "Talk to a Game Master"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkText1" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 25
offset_top = 84
offset_right = 575
offset_bottom = 96
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontHighlight"
text = "Game Masters are normally available to assist 24 hours a day. The next available Game Master will be able to assist you no matter which character you are currently playing on.  Please keep in mind wait times may vary, and there are some issues that Game Masters will |cffffd200NOT|r be able to assist you with.  Those issues include, but are |cffffd200NOT|r limited to the following:"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue1Header" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 106
offset_right = 575
offset_bottom = 118
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontNormal"
text = "Game Hints"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue1" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 118
offset_right = 575
offset_bottom = 128
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontHighlightSmall"
text = "This includes information about:  quests, non-player characters (NPCs), items, locations, or anything else that the player could possibly find out through exploration and/or interaction with the world or other players."
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue2Header" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 138
offset_right = 575
offset_bottom = 150
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontNormal"
text = "Meta-Game Hints"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue2" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 150
offset_right = 575
offset_bottom = 160
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontHighlightSmall"
text = "This includes information about:  an upcoming patch (what, when, how), upcoming content additions, game play changes, and future rule changes."
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue3Header" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 170
offset_right = 575
offset_bottom = 182
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontNormal"
text = "PvP"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkIssue3" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 35
offset_top = 182
offset_right = 575
offset_bottom = 192
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontHighlightSmall"
text = "Most PVP issues can be resolved through the PVP game mechanics. GM's will not be able to assist in many cases.  The exceptions to this rule are any behaviors that fall under the World of Warcraft Harassment Policy.  For special rules designated for PvP activity, please go to:"
horizontal_alignment = 0
vertical_alignment = 1

[node name="HelpFrameGMTalkPvpPolicyUrl" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 30
offset_top = 202
offset_right = 580
offset_bottom = 197
mouse_filter = 2
theme_type_variation = &"GameFontNormal"
text = "|cffffd200http://www.worldofwarcraft.com/policy/pvp.shtml|r"
horizontal_alignment = 1
vertical_alignment = 1
grow_horizontal = 2
grow_vertical = 2

[node name="HelpFrameGMTalkText2" type="Label" parent="HelpFrameGMTalk"]
unique_name_in_owner = true
offset_left = 30
offset_top = 222
offset_right = 580
offset_bottom = 234
grow_horizontal = 1
grow_vertical = 1
mouse_filter = 2
theme_type_variation = &"GameFontHighlight"
text = "Additionally, we encourage all players to first utilize the forums and the website to pursue information about their respective issues at |cffffd200www.worldofwarcraft.com|r , and request that specific attention be paid to our game policies at |cffffd200www.worldofwarcraft.com/policy/|r ."
horizontal_alignment = 0
vertical_alignment = 1

