#!/usr/bin/env python
# Builds the wowdot GDExtension: scons -j 8 target=template_debug

# godot-cpp reads custom.py relative to its own directory unless the path is exported.
customs = [File("custom.py").abspath]
Export("customs")
env = SConscript("godot-cpp/SConstruct")

# mWoWee sources are C++20; the later flag overrides godot-cpp's -std=c++17.
env.Append(CXXFLAGS=["-std=c++20"])

# `scons sanitize=yes` instruments the library; run Godot with LD_PRELOAD="$(gcc -print-file-name=libasan.so)".
if ARGUMENTS.get("sanitize") == "yes":
	sanitizers = ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
	env.Append(CCFLAGS=sanitizers, LINKFLAGS=sanitizers)
thirdparty = [
	"thirdparty/StormLib/src/",
	"thirdparty/StormLib/src/libtommath/",
	"thirdparty/StormLib/src/libtomcrypt/src/headers/",
	"thirdparty/glm/",
	"thirdparty/json/single_include/",
	"thirdparty/zlib/",
	"thirdparty/bzip2/",
]
env.Append(CPPPATH=["src/", "wowee/include/"] + thirdparty)
windows = env["platform"] == "windows"
if windows:
	env.Append(LIBS=["ws2_32", "wininet"])
# Windows sources read tommath.h through this header so LibTomMath uses its 28-bit digits.
tommath_flags = ["-include", File("thirdparty/tommath_llp64.h").abspath] if windows else []

# Our own sources build with full warnings; vendored mWoWee and StormLib keep their upstream flags.
strict_env = env.Clone()
strict_env.Append(CXXFLAGS=["-Wall", "-Wextra", "-Wpedantic", "-Wshadow"], CCFLAGS=tommath_flags)
for header_dir in ["godot-cpp/include", "godot-cpp/gen/include", "godot-cpp/gdextension", "wowee/include"] + thirdparty:
	strict_env.Append(CXXFLAGS=["-isystem", Dir(header_dir).abspath])
wowee_env = env.Clone()
wowee_env.Append(CCFLAGS=tommath_flags)
sources = [strict_env.SharedObject(f) for f in Glob("src/*.cpp")]
sources += [wowee_env.SharedObject(f) for f in Glob("wowee/src/*/*.cpp")]

# StormLib is compiled in because Arch's libstorm.a holds LTO bytecode only; its file lists come from its CMakeLists.
import re

storm_dir = "thirdparty/StormLib/"
storm_cmake = open(storm_dir + "CMakeLists.txt").read()
storm_sources = []
for name in ["SRC_FILES", "TOMCRYPT_FILES", "TOMMATH_FILES"]:
	block = re.search(r"set\(" + name + r"\s+(.*?)\)", storm_cmake, re.S).group(1)
	storm_sources += [storm_dir + f for f in block.split() if f.endswith((".c", ".cpp"))]
# zlib and bzip2 come from their own submodules; StormLib's bundled copies are 1.2.5 and 1.0.5.
zlib_names = ["adler32", "compress", "crc32", "deflate", "infback", "inffast", "inflate", "inftrees", "trees", "uncompr", "zutil"]
bzip2_names = ["blocksort", "bzlib", "compress", "crctable", "decompress", "huffman", "randtable"]
storm_sources += ["thirdparty/zlib/{}.c".format(n) for n in zlib_names]
storm_sources += ["thirdparty/bzip2/{}.c".format(n) for n in bzip2_names]
storm_env = env.Clone()
storm_env.Append(CPPDEFINES=["_7ZIP_ST", "BZ_STRICT_ANSI", "__SYS_ZLIB", "__SYS_BZLIB"])
tommath_env = storm_env.Clone()
tommath_env.Append(CCFLAGS=tommath_flags)
for f in storm_sources:
	uses_tommath = "/libtommath/" in f or f.endswith("/ltm_desc.c")
	sources.append((tommath_env if uses_tommath else storm_env).SharedObject(f))

library = env.SharedLibrary(
	"../shared/wowdot/bin/libwowdot{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
	source=sources,
)

env.NoCache(library)
Default(library)
