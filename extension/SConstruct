#!/usr/bin/env python
# Builds the wowgd GDExtension: scons -j 8 target=template_debug

# godot-cpp reads custom.py relative to its own directory unless the path is exported.
customs = [File("custom.py").abspath]
Export("customs")
env = SConscript("godot-cpp/SConstruct")

# mWoWee sources are C++20; the later flag overrides godot-cpp's -std=c++17.
env.Append(CXXFLAGS=["-std=c++20"])

# `scons sanitize=yes` instruments the library; run Godot with LD_PRELOAD="$(gcc -print-file-name=libasan.so)".
if ARGUMENTS.get("sanitize") == "yes":
	sanitizers = ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
	env.Append(CCFLAGS=sanitizers, LINKFLAGS=sanitizers)
env.Append(CPPPATH=["src/", "wowee/include/", "thirdparty/StormLib/src/"])
windows = env["platform"] == "windows"
if windows:
	# mingw has zlib only: libcrypto is cross-built into ../../deps/mingw, bzip2 comes from StormLib.
	env.Append(CPPPATH=["../../deps/mingw/include"], LIBPATH=["../../deps/mingw/lib64"])
	env.Append(LIBS=["crypto", "z", "ws2_32", "crypt32", "wininet"])
else:
	env.Append(LIBS=["z", "bz2", "crypto"])

# Our own sources build with full warnings; vendored mWoWee and StormLib keep their upstream flags.
strict_env = env.Clone()
strict_env.Append(CXXFLAGS=["-Wall", "-Wextra", "-Wpedantic", "-Wshadow"])
for header_dir in ["godot-cpp/include", "godot-cpp/gen/include", "godot-cpp/gdextension", "wowee/include", "thirdparty/StormLib/src"]:
	strict_env.Append(CXXFLAGS=["-isystem", Dir(header_dir).abspath])
sources = [strict_env.SharedObject(f) for f in Glob("src/*.cpp")] + Glob("wowee/src/*/*.cpp")

# StormLib is compiled in because Arch's libstorm.a holds LTO bytecode only; its file lists come from its CMakeLists.
import re

storm_dir = "thirdparty/StormLib/"
storm_cmake = open(storm_dir + "CMakeLists.txt").read()
storm_sources = []
for name in ["SRC_FILES", "TOMCRYPT_FILES", "TOMMATH_FILES"] + (["BZIP2_FILES"] if windows else []):
	block = re.search(r"set\(" + name + r"\s+(.*?)\)", storm_cmake, re.S).group(1)
	storm_sources += [storm_dir + f for f in block.split() if f.endswith((".c", ".cpp"))]
storm_env = env.Clone()
storm_env.Append(CPPDEFINES=["_7ZIP_ST", "BZ_STRICT_ANSI", "__SYS_ZLIB"] + ([] if windows else ["__SYS_BZLIB"]))
sources += [storm_env.SharedObject(f) for f in storm_sources]

library = env.SharedLibrary(
	"../bin/libwowgd{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
	source=sources,
)

env.NoCache(library)
Default(library)
